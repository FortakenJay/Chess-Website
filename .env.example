VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Server-only. Required for the daily Vercel cron at /api/sync-user
# and for saving the shared puzzles catalog.
SUPABASE_SERVICE_ROLE_KEY=...
CRON_SECRET=generate-a-long-random-string

CHESSCOM_USER_AGENT=leak/1.0 (personal chess analysis)

# Optional: bulk-import the Lichess dump into Supabase
#   npm run puzzles:import-full
# Download is ~290MB compressed; import can take a long time (millions of rows).
# VITE_SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY above are required for DB upsert.

# Opening trainer: seed shared cards, import a PGN, then pull Lichess explorer deviations.
#   npm run openings:seed
#   npm run openings:import -- --file repertoire.pgn --username yourhandle --side w
#   npm run openings:explorer -- --username yourhandle --rating 1600