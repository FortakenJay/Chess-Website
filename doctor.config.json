{
  "$schema": "https://react.doctor/schema/config.json",
  "ignore": {
    "files": [".env.local", "**/.env.local"],
    "rules": [
      "react-doctor/only-export-components",
      "deslop/unused-export"
    ],
    "overrides": [
      {
        "files": [
          "src/lib/analysis/analyzeGame.ts",
          "src/lib/analyzeClient.ts",
          "src/workers/analyze.worker.ts",
          "src/lib/persist.ts",
          "src/lib/puzzles/**/*.ts",
          "src/routes/api/sync-user.ts"
        ],
        "rules": ["react-doctor/async-await-in-loop"]
      },
      {
        "files": ["src/components/ResultsCharts.tsx", "src/components/charts.tsx"],
        "rules": ["react-doctor/prefer-dynamic-import"]
      }
    ]
  }
}
